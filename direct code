function buildHistorySummary(){
  const finishedOrAbandoned = state.books.filter(b=> b.status==='Finished' || b.status==='Abandoned');
  if(finishedOrAbandoned.length === 0) return 'No finished or abandoned books logged yet.';
  return finishedOrAbandoned.map(b=>{
    return `- "${b.title}" by ${b.author} | genre: ${b.genre||'unspecified'} | status: ${b.status} | rating: ${b.rating||'unrated'}/5 | liked: ${(b.favoriteQualities||[]).join(', ')||'none noted'} | disliked: ${(b.dislikedQualities||[]).join(', ')||'none noted'} | notes: ${b.notes||'none'}`;
  }).join('\n');
}

async function runRecommendation(prefs){
  state.recStatus = 'loading';
  state.recResult = null;
  renderRecResults();

  const historySummary = buildHistorySummary();
  const wantToRead = state.books.filter(b=>b.status==='Want to Read').map(b=>`${b.title} by ${b.author}`).join(', ') || 'none';

  const schema = `{
  "bestPick": { "title": string, "author": string, "genre": string, "description": string, "whyFits": string, "similarities": string, "possibleDownsides": string, "pageCount": number|null, "publicationYear": number|null, "seriesInfo": string|null, "sources": [{"name": string, "url": string}] },
  "alternatives": [ /* up to 2 objects with the same shape as bestPick */ ]
}`;

  const systemPrompt = `You are a meticulous personal reading advisor. You MUST use the web_search tool to verify every book you recommend — including its author, page count, publication year, and whether it's part of a series — before including it in your answer. To keep response time reasonable, use AT MOST ONE web search per book (combine title/author/page count/series into a single search query per book) and recommend AT MOST 3 books total (one bestPick, up to two alternatives) — do not exceed 3 searches total. Never invent or guess at titles, authors, page counts, or publication years; if a detail can't be confirmed via search, use null for that field rather than fabricating it. Do not recommend a book only because it is popular — prioritize genuine fit with the reader's history. Do not recommend books the reader has already finished or abandoned, unless there is a clear reason. Descriptions must be spoiler-free. Respond with ONLY a single valid JSON object matching this exact schema, no markdown fences, no commentary before or after: ${schema}. Include real, working source URLs (e.g. publisher pages, Goodreads, NPR, library catalogs) gathered from your search for every book in "sources".`;

  const userPrompt = `READER'S FINISHED/ABANDONED BOOKS (their real reading history — analyze ratings, favorite qualities, disliked qualities, repeated genres, and preferred authors carefully):
${historySummary}

READER'S CURRENT "WANT TO READ" LIST (do not recommend books already on this list): ${wantToRead}

CURRENT PREFERENCES FOR THIS RECOMMENDATION:
- Mood: ${prefs.mood}
- Preferred genre: ${prefs.genre || 'no strong preference — infer from history'}
- Desired length: ${prefs.length}
- Desired difficulty: ${prefs.difficulty}
- Fiction or nonfiction: ${prefs.category}
- Familiar vs different: ${prefs.familiarity}
- Available reading time: ${prefs.timeAvailable}

Recommend one "bestPick" and up to two "alternatives", ranked. Verify every book via a single web search per book before including it.`;

  let timeoutId;
  const timeoutPromise = new Promise((_, reject)=>{
    timeoutId = setTimeout(()=> reject(new Error('TIMEOUT')), 75000);
  });

  try{
    const fetchPromise = fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 4096,
        system: systemPrompt,
        messages: [{ role: "user", content: userPrompt }],
        tools: [{ type: "web_search_20250305", name: "web_search" }]
      })
    });
    const response = await Promise.race([fetchPromise, timeoutPromise]);
    clearTimeout(timeoutId);

    if(!response.ok){
      throw new Error(`Request failed (status ${response.status}).`);
    }
    const data = await response.json();
    const textBlocks = (data.content || []).filter(b => b.type === 'text').map(b => b.text);
    let raw = textBlocks.join('\n').trim();
    raw = raw.replace(/^```json\s*/i, '').replace(/^```\s*/i, '').replace(/```\s*$/i, '').trim();

    const firstBrace = raw.indexOf('{');
    const lastBrace = raw.lastIndexOf('}');
    if(firstBrace === -1 || lastBrace === -1) throw new Error('No JSON found in the response.');
    raw = raw.slice(firstBrace, lastBrace+1);

    const parsed = JSON.parse(raw);
    if(!parsed.bestPick || !parsed.bestPick.title) throw new Error('Response was missing a recommendation.');

    const timestamp = new Date().toISOString();
    state.recResult = { ...parsed, timestamp };
    state.recStatus = 'success';

    const histEntry = {
      timestamp,
      date: new Date().toLocaleDateString(),
      preferences: { ...prefs },
      recommended: [parsed.bestPick, ...(parsed.alternatives||[])].map(r=>r.title),
      bestMatch: parsed.bestPick.title,
      actions: {}
    };
    state.history.unshift(histEntry);
    saveHistory();

  }catch(err){
    clearTimeout(timeoutId);
    state.recStatus = 'error';
    if(err && err.message === 'TIMEOUT'){
      state.recError = "This is taking longer than expected (over 75 seconds). Try again, or narrow your preferences \u2014 a specific genre and shorter length usually finds a match faster.";
    }else{
      state.recError = err.message || 'Something went wrong while searching for a recommendation.';
    }
  }
  renderRecResults();
}

function addRecommendationToShelf(rec, i, timestamp){
  const exists = state.books.some(b=> b.title.toLowerCase()===rec.title.toLowerCase() && b.author.toLowerCase()===rec.author.toLowerCase());
  if(!exists){
    state.books.push({
      id: uid(), title: rec.title, author: rec.author, genre: rec.genre || '',
      status: 'Want to Read', dateStarted: '', dateFinished: '', rating: 0,
      favoriteQualities: [], dislikedQualities: [],
      notes: `Added from a recommendation. ${rec.pageCount ? rec.pageCount+'pp. ' : ''}${rec.publicationYear ? '('+rec.publicationYear+')' : ''}`.trim()
    });
    saveBooks();
    toast(`"${rec.title}" added to Want to Read.`, 'success');
  }else{
    toast(`"${rec.title}" is already on your shelf.`, 'error');
  }
  logRecAction(timestamp, rec.title, 'added');
}

function rejectRecommendation(rec, i, timestamp){
  logRecAction(timestamp, rec.title, 'rejected');
  toast(`Dismissed "${rec.title}".`, 'success');
}

function logRecAction(timestamp, title, action){
  const entry = state.history.find(h=>h.timestamp===timestamp);
  if(entry){
    entry.actions[title] = action;
    saveHistory();
  }
  renderRecResults();
}

/* ============================= HISTORY ============================= */
function renderHistory(){
  const el = document.getElementById('panel-history');
  if(state.history.length === 0){
    el.innerHTML = `
      <h2 class="section-title">Recommendation History</h2>
      <div class="empty-state">
        <div class="glyph">≡</div>
        <p>No recommendations yet. Run one from the Recommend tab and it'll show up here.</p>
        <button class="btn" id="hist-go-btn">Get a Recommendation</button>
      </div>`;
    document.getElementById('hist-go-btn').addEventListener('click', ()=>switchTab('recommend'));
    return;
  }

  el.innerHTML = `
    <h2 class="section-title">Recommendation History</h2>
    <p class="section-sub">Every recommendation run, with what you did about it.</p>
    ${ state.history.map(h => `
      <div class="card history-entry">
        <p class="history-date">${esc(h.date)}</p>
        <p class="history-prefs">Mood: ${esc(h.preferences.mood)} · Genre: ${esc(h.preferences.genre||'no preference')} · Length: ${esc(h.preferences.length)} · ${esc(h.preferences.category)}</p>
        <ul class="history-books">
          ${ h.recommended.map(title => {
            const action = h.actions[title];
            const tag = action === 'added' ? '<span class="tag-added">Added</span>' : action === 'rejected' ? '<span class="tag-rejected">Rejected</span>' : '<span class="tag-pending">Pending</span>';
            const isBest = title === h.bestMatch;
            return `<li>${isBest ? '★ ' : ''}${esc(title)} ${tag}</li>`;
          }).join('') }
        </ul>
      </div>
    `).join('') }
  `;
}

/* ============================= INIT ============================= */
async function init(){
  const [books, history, onboarded] = await Promise.all([loadBooks(), loadHistory(), getOnboarded()]);
  state.books = books;
  state.history = history;

  state.showHelp = !onboarded;
  if(!onboarded){ setOnboarded(); }
  renderActive();
}

init();
</script>
