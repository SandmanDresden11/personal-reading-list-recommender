        <div class="msg" style="font-size:11px; color:var(--slate);">This checks live sources, so it can take up to a minute.</div>
      </div>`;
    return;
  }
  if(state.recStatus === 'error'){
    box.innerHTML = `
      <div class="error-state">
        <strong>Couldn't put together a recommendation.</strong>
        <p style="margin:6px 0 0;">${esc(state.recError)}</p>
        <button class="btn brass" id="rec-retry">Try Again</button>
      </div>`;
    document.getElementById('rec-retry').addEventListener('click', ()=> runRecommendation(recPrefs));
    return;
  }
  if(state.recStatus === 'success' && state.recResult){
    const r = state.recResult;
    const all = [ { ...r.bestPick, __best:true }, ...(r.alternatives||[]) ];
    box.innerHTML = `
      <h3 style="font-family:var(--font-display); font-size:18px; margin:0 0 4px;">Recommendations</h3>
      <p class="section-sub">Based on ${state.books.filter(b=>b.status==='Finished'||b.status==='Abandoned').length} finished/abandoned books on your shelf.</p>
      ${ all.map((rec,i)=> recCardHTML(rec, i, r.timestamp)).join('') }
    `;
    all.forEach((rec,i)=>{
      const addBtn = document.getElementById(`rec-add-${i}`);
      const rejectBtn = document.getElementById(`rec-reject-${i}`);
      if(addBtn) addBtn.addEventListener('click', ()=> addRecommendationToShelf(rec, i, r.timestamp));
      if(rejectBtn) rejectBtn.addEventListener('click', ()=> rejectRecommendation(rec, i, r.timestamp));
    });
    return;
  }
  box.innerHTML = '';
}

