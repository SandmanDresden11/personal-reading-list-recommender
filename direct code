function renderShelf(){
  const el = document.getElementById('panel-shelf');
  if(state.books.length === 0){
    el.innerHTML = `
      <h2 class="section-title">My Shelf</h2>
      <div class="empty-state">
        <div class="glyph">☐</div>
        <p>Your shelf is empty. Add a book to start tracking your reading.</p>
        <button class="btn" id="shelf-add-btn">Add a Book</button>
      </div>`;
    document.getElementById('shelf-add-btn').addEventListener('click', ()=>switchTab('add'));
    return;
  }

  const genres = [...new Set(state.books.map(b=>b.genre).filter(Boolean))].sort();
  const authors = [...new Set(state.books.map(b=>b.author).filter(Boolean))].sort();

  let filtered = state.books.filter(b=>{
    if(state.filters.status !== 'all' && b.status !== state.filters.status) return false;
    if(state.filters.genre !== 'all' && b.genre !== state.filters.genre) return false;
    if(state.filters.author && !b.author.toLowerCase().includes(state.filters.author.toLowerCase())) return false;
    if(state.filters.minRating > 0 && Number(b.rating||0) < state.filters.minRating) return false;
    return true;
  });
  filtered = filtered.slice().sort((a,b)=> (b.id||'').localeCompare(a.id||''));

  el.innerHTML = `
    <h2 class="section-title">My Shelf</h2>
    <p class="section-sub">${state.books.length} book${state.books.length===1?'':'s'} total · showing ${filtered.length}</p>

    <div class="filter-bar">
      <div class="field">
        <label for="f-status">Status</label>
        <select id="f-status">
          <option value="all">All statuses</option>
          ${STATUSES.map(s=>`<option value="${s}" ${state.filters.status===s?'selected':''}>${s}</option>`).join('')}
        </select>
      </div>
      <div class="field">
        <label for="f-genre">Genre</label>
        <select id="f-genre">
          <option value="all">All genres</option>
          ${genres.map(g=>`<option value="${esc(g)}" ${state.filters.genre===g?'selected':''}>${esc(g)}</option>`).join('')}
        </select>
      </div>
      <div class="field">
        <label for="f-author">Author</label>
        <input type="text" id="f-author" placeholder="Search author…" value="${esc(state.filters.author)}" list="author-list">
        <datalist id="author-list">${authors.map(a=>`<option value="${esc(a)}">`).join('')}</datalist>
      </div>
      <div class="field">
        <label for="f-rating">Min. rating</label>
        <select id="f-rating">
          <option value="0" ${state.filters.minRating===0?'selected':''}>Any</option>
          ${[1,2,3,4,5].map(n=>`<option value="${n}" ${state.filters.minRating===n?'selected':''}>${n}+ ★</option>`).join('')}
        </select>
      </div>
      <button class="btn secondary small" id="clear-filters">Clear filters</button>
    </div>

    <div class="grid books" id="book-grid">
      ${ filtered.length ? filtered.map(bookCardHTML).join('') : '<p class="section-sub">No books match these filters.</p>' }
    </div>
  `;

  document.getElementById('f-status').addEventListener('change', e=>{ state.filters.status = e.target.value; renderShelf(); });
  document.getElementById('f-genre').addEventListener('change', e=>{ state.filters.genre = e.target.value; renderShelf(); });
  document.getElementById('f-author').addEventListener('input', e=>{ state.filters.author = e.target.value; renderShelf(); });
  document.getElementById('f-rating').addEventListener('change', e=>{ state.filters.minRating = Number(e.target.value); renderShelf(); });
  document.getElementById('clear-filters').addEventListener('click', ()=>{
    state.filters = { status:'all', genre:'all', author:'', minRating:0 }; renderShelf();
  });

  el.querySelectorAll('[data-action="edit"]').forEach(b=>b.addEventListener('click', ()=> startEdit(b.dataset.id)));
  el.querySelectorAll('[data-action="delete"]').forEach(b=>b.addEventListener('click', ()=> deleteBook(b.dataset.id)));
  el.querySelectorAll('[data-action="cycle-status"]').forEach(b=>b.addEventListener('click', ()=> cycleStatus(b.dataset.id)));
}

function bookCardHTML(b){
  return `
    <div class="card book-card">
      <div class="shelf-mark">${shelfMark(b)}</div>
      <p class="book-title">${esc(b.title)}</p>
      <p class="book-author">${esc(b.author)}</p>
      <div class="badge-row">
        <span class="badge ${statusClass(b.status)}">${esc(b.status)}</span>
        ${b.genre ? `<span class="badge genre">${esc(b.genre)}</span>` : ''}
      </div>
      ${ Number(b.rating) > 0 ? `<div class="rating-stars">${starString(b.rating)}</div>` : '' }
      ${ b.favoriteQualities && b.favoriteQualities.length ? `<p class="quality-line"><b>Liked:</b> ${esc(b.favoriteQualities.join(', '))}</p>` : '' }
      ${ b.dislikedQualities && b.dislikedQualities.length ? `<p class="quality-line"><b>Disliked:</b> ${esc(b.dislikedQualities.join(', '))}</p>` : '' }
      ${ b.notes ? `<p class="book-notes">${esc(b.notes)}</p>` : '' }
      <div class="book-actions">
        <button class="btn subtle" data-action="edit" data-id="${b.id}">Edit</button>
        <button class="btn subtle" data-action="cycle-status" data-id="${b.id}">Change status</button>
        <button class="btn subtle" data-action="delete" data-id="${b.id}">Delete</button>
      </div>
    </div>`;
}

function cycleStatus(id){
  const b = state.books.find(x=>x.id===id);
  if(!b) return;
  const idx = STATUSES.indexOf(b.status);
  b.status = STATUSES[(idx+1) % STATUSES.length];
  if(b.status === 'Finished' && !b.dateFinished){ b.dateFinished = new Date().toISOString().slice(0,10); }
  saveBooks();
  toast(`Status changed to "${b.status}".`, 'success');
  renderShelf();
}

function deleteBook(id){
  const b = state.books.find(x=>x.id===id);
  if(!b) return;
  if(!confirm(`Remove "${b.title}" from your shelf? This can't be undone.`)) return;
  state.books = state.books.filter(x=>x.id!==id);
  saveBooks();
  toast('Book removed from shelf.', 'success');
  renderShelf();
}

function startEdit(id){
  state.editingId = id;
  switchTab('add');
}

