<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>What Should I Read Next?</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink: #1C2541;
    --ink-soft: #3A4360;
    --paper: #E7DFCB;
    --paper-card: #F6F1E4;
    --paper-raised: #FBF8F0;
    --brass: #B8935F;
    --brass-dark: #8C6D42;
    --burgundy: #7A2E38;
    --burgundy-soft: #A9525C;
    --sage: #52684F;
    --sage-soft: #7C9678;
    --rust: #A0522D;
    --slate: #6B7280;
    --line: rgba(28,37,65,0.14);
    --line-strong: rgba(28,37,65,0.28);
    --shadow: 0 1px 2px rgba(28,37,65,0.06), 0 4px 14px rgba(28,37,65,0.07);
    --radius: 3px;
    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'Inter', -apple-system, sans-serif;
    --font-mono: 'IBM Plex Mono', 'Courier New', monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      repeating-linear-gradient(180deg, rgba(28,37,65,0.015) 0px, rgba(28,37,65,0.015) 1px, transparent 1px, transparent 34px),
      var(--paper);
    color:var(--ink);
    font-family:var(--font-body);
    font-size:15px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }
  button{font-family:inherit;}
  a{color:var(--brass-dark);}
  :focus-visible{outline:2px solid var(--brass-dark); outline-offset:2px;}

  /* ---------- Header ---------- */
  .app-shell{max-width:1080px; margin:0 auto; padding:0 20px 80px;}
  header.top{
    padding:34px 0 18px;
    border-bottom:2px solid var(--ink);
    margin-bottom:0;
    position:relative;
  }
  .eyebrow{
    font-family:var(--font-mono);
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--brass-dark);
    margin:0 0 6px;
  }
  h1.title{
    font-family:var(--font-display);
    font-weight:600;
    font-optical-sizing:auto;
    font-size:clamp(28px,4.5vw,42px);
    margin:0 0 6px;
    color:var(--ink);
    letter-spacing:-0.01em;
  }
  .subtitle{color:var(--ink-soft); font-size:14.5px; max-width:560px; margin:0;}

  /* ---------- Tabs ---------- */
  nav.tabs{
    display:flex;
    gap:2px;
    margin:0;
    padding:0;
    list-style:none;
    overflow-x:auto;
    border-bottom:1px solid var(--line-strong);
    -ms-overflow-style:none; scrollbar-width:none;
  }
  nav.tabs::-webkit-scrollbar{display:none;}
  .tab-btn{
    flex:0 0 auto;
    background:transparent;
    border:none;
    border-bottom:3px solid transparent;
    padding:13px 16px 11px;
    font-family:var(--font-mono);
    font-size:12.5px;
    letter-spacing:0.04em;
    text-transform:uppercase;
    color:var(--slate);
    cursor:pointer;
    white-space:nowrap;
    transition:color .15s ease, border-color .15s ease;
  }
  .tab-btn:hover{color:var(--ink);}
  .tab-btn.active{color:var(--ink); border-bottom-color:var(--brass-dark); font-weight:600;}

  main{padding-top:26px;}
  .panel{display:none; animation:fadein .25s ease;}
  .panel.active{display:block;}
  @keyframes fadein{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);}}

  h2.section-title{
    font-family:var(--font-display);
    font-size:22px;
    font-weight:600;
    margin:0 0 4px;
  }
  .section-sub{color:var(--slate); font-size:13.5px; margin:0 0 20px;}

  /* ---------- Cards / grid ---------- */
  .card{
    background:var(--paper-card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
  }
  .grid{display:grid; gap:14px;}
  .grid.stats{grid-template-columns:repeat(4,1fr);}
  .grid.books{grid-template-columns:repeat(auto-fill,minmax(260px,1fr));}
  @media (max-width:760px){
    .grid.stats{grid-template-columns:repeat(2,1fr);}
  }

  .stat-card{padding:16px 18px; position:relative;}
  .stat-card .num{font-family:var(--font-display); font-size:30px; font-weight:600; line-height:1;}
  .stat-card .label{font-family:var(--font-mono); font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--slate); margin-top:6px;}

  .bar-row{display:flex; align-items:center; gap:10px; margin-bottom:10px;}
  .bar-row .bar-label{width:120px; font-size:13px; flex:0 0 auto; color:var(--ink-soft);}
  .bar-track{flex:1; height:10px; background:rgba(28,37,65,0.07); border-radius:2px; overflow:hidden;}
  .bar-fill{height:100%; background:linear-gradient(90deg,var(--brass),var(--brass-dark)); border-radius:2px;}
  .bar-count{width:26px; text-align:right; font-family:var(--font-mono); font-size:12px; color:var(--slate);}

  .mini-list{list-style:none; margin:0; padding:0;}
  .mini-list li{display:flex; justify-content:space-between; gap:10px; padding:9px 0; border-bottom:1px solid var(--line);}
  .mini-list li:last-child{border-bottom:none;}
  .mini-title{font-weight:600; font-size:13.5px;}
  .mini-meta{color:var(--slate); font-size:12px;}

  .two-col{display:grid; grid-template-columns:1.4fr 1fr; gap:16px;}
  @media (max-width:760px){.two-col{grid-template-columns:1fr;}}

  /* ---------- Book card ---------- */
  .book-card{padding:14px 16px 14px; display:flex; flex-direction:column; gap:8px; position:relative;}
  .shelf-mark{font-family:var(--font-mono); font-size:10px; letter-spacing:0.05em; color:var(--brass-dark); position:absolute; top:12px; right:14px;}
  .book-title{font-family:var(--font-display); font-weight:600; font-size:17px; margin:0; padding-right:70px;}
  .book-author{color:var(--ink-soft); font-size:13px; margin:-4px 0 0;}
  .badge-row{display:flex; flex-wrap:wrap; gap:6px; margin-top:2px;}
  .badge{
    font-family:var(--font-mono); font-size:10.5px; letter-spacing:0.04em; text-transform:uppercase;
    padding:3px 8px; border-radius:2px; border:1px solid transparent;
  }
  .badge.status-want{background:rgba(107,114,128,0.12); color:var(--slate); border-color:rgba(107,114,128,0.25);}
  .badge.status-reading{background:rgba(184,147,95,0.16); color:var(--brass-dark); border-color:rgba(184,147,95,0.35);}
  .badge.status-finished{background:rgba(82,104,79,0.14); color:var(--sage); border-color:rgba(82,104,79,0.3);}
  .badge.status-paused{background:rgba(160,82,45,0.13); color:var(--rust); border-color:rgba(160,82,45,0.3);}
  .badge.status-abandoned{background:rgba(122,46,56,0.12); color:var(--burgundy); border-color:rgba(122,46,56,0.3);}
  .badge.genre{background:rgba(28,37,65,0.06); color:var(--ink-soft); border-color:var(--line);}
  .rating-stars{font-family:var(--font-mono); color:var(--brass-dark); font-size:13px; letter-spacing:1px;}
  .rating-stars .empty{color:rgba(184,147,95,0.3);}
  .book-notes{font-size:12.5px; color:var(--ink-soft); margin:2px 0 0;}
  .quality-line{font-size:12px; color:var(--slate); margin:0;}
  .quality-line b{color:var(--ink-soft); font-weight:600;}
  .book-actions{display:flex; gap:8px; margin-top:8px; flex-wrap:wrap;}

  /* ---------- Buttons ---------- */
  .btn{
    font-family:var(--font-body); font-weight:600; font-size:13px;
    padding:9px 16px; border-radius:2px; border:1px solid var(--ink);
    background:var(--ink); color:var(--paper-raised); cursor:pointer;
    transition:transform .1s ease, background .15s ease;
  }
  .btn:hover{background:var(--ink-soft);}
  .btn:active{transform:translateY(1px);}
  .btn.secondary{background:transparent; color:var(--ink); border-color:var(--line-strong);}
  .btn.secondary:hover{background:rgba(28,37,65,0.05);}
  .btn.subtle{background:transparent; color:var(--slate); border-color:transparent; padding:6px 8px; font-size:12px;}
  .btn.subtle:hover{color:var(--burgundy); text-decoration:underline;}
  .btn.small{padding:6px 11px; font-size:12px;}
  .btn.brass{background:var(--brass-dark); border-color:var(--brass-dark); color:#fff;}
  .btn.brass:hover{background:var(--brass);}
  .btn:disabled{opacity:0.5; cursor:not-allowed;}

  /* ---------- Forms ---------- */
  form.card{padding:20px 22px;}
  .field-grid{display:grid; grid-template-columns:1fr 1fr; gap:14px;}
  @media (max-width:640px){.field-grid{grid-template-columns:1fr;}}
  .field{display:flex; flex-direction:column; gap:5px; margin-bottom:14px;}
  .field label{font-size:12.5px; font-weight:600; color:var(--ink-soft);}
  .field .hint{font-size:11px; color:var(--slate); font-weight:400;}
  input[type=text], input[type=number], input[type=date], select, textarea{
    font-family:var(--font-body); font-size:13.5px; padding:9px 10px;
    border:1px solid var(--line-strong); border-radius:2px; background:var(--paper-raised); color:var(--ink);
  }
  textarea{resize:vertical; min-height:60px;}
  input:focus, select:focus, textarea:focus{border-color:var(--brass-dark);}
  .form-actions{display:flex; gap:10px; margin-top:6px;}

  /* ---------- Filter bar ---------- */
  .filter-bar{display:flex; flex-wrap:wrap; gap:10px; margin-bottom:18px; align-items:flex-end;}
  .filter-bar .field{margin-bottom:0; min-width:140px;}

  /* ---------- Empty / loading / error states ---------- */
  .empty-state{
    text-align:center; padding:48px 20px; border:1px dashed var(--line-strong); border-radius:var(--radius);
    color:var(--ink-soft);
  }
  .empty-state .glyph{font-family:var(--font-display); font-size:34px; color:var(--brass); margin-bottom:8px;}
  .empty-state p{margin:4px 0 14px; font-size:13.5px;}

  .loading-state{display:flex; flex-direction:column; align-items:center; gap:14px; padding:50px 20px; color:var(--ink-soft);}
  .spinner{
    width:30px; height:30px; border-radius:50%;
    border:3px solid rgba(184,147,95,0.25); border-top-color:var(--brass-dark);
    animation:spin 0.9s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg);}}
  .loading-state .msg{font-family:var(--font-mono); font-size:12.5px; letter-spacing:0.02em;}

  .error-state{
    padding:18px 20px; border:1px solid rgba(122,46,56,0.35); background:rgba(122,46,56,0.06);
    border-radius:var(--radius); color:var(--burgundy); font-size:13.5px;
  }
  .error-state .btn{margin-top:10px;}

  /* ---------- Toast ---------- */
  #toast-region{position:fixed; bottom:18px; left:50%; transform:translateX(-50%); z-index:999; display:flex; flex-direction:column; gap:8px; align-items:center;}
  .toast{
    font-size:13px; padding:10px 16px; border-radius:3px; box-shadow:var(--shadow);
    background:var(--ink); color:var(--paper-raised); animation:toastin .2s ease;
  }
  .toast.error{background:var(--burgundy);}
  .toast.success{background:var(--sage);}
  @keyframes toastin{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);}}

  /* ---------- Recommendation cards ---------- */
  .rec-card{padding:20px 22px; margin-bottom:16px; position:relative;}
  .rec-card.best{border:2px solid var(--brass-dark); background:linear-gradient(180deg, rgba(184,147,95,0.08), var(--paper-card) 60px);}
  .rec-pick-label{
    font-family:var(--font-mono); font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase;
    color:var(--brass-dark); font-weight:600; margin:0 0 8px;
  }
  .rec-title{font-family:var(--font-display); font-size:19px; font-weight:600; margin:0 0 2px;}
  .rec-author{color:var(--ink-soft); font-size:13.5px; margin:0 0 10px;}
  .rec-meta-row{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:10px;}
  .rec-block{margin:10px 0;}
  .rec-block h4{font-family:var(--font-mono); font-size:11px; letter-spacing:0.06em; text-transform:uppercase; color:var(--slate); margin:0 0 4px; font-weight:600;}
  .rec-block p{margin:0; font-size:13.5px; line-height:1.55;}
  .sources{font-size:11.5px; color:var(--slate); margin-top:12px; padding-top:10px; border-top:1px solid var(--line);}
  .sources a{color:var(--brass-dark); word-break:break-word;}
  .rec-actions{display:flex; gap:8px; margin-top:14px;}
  .rec-status-tag{font-family:var(--font-mono); font-size:10.5px; color:var(--sage); margin-top:10px;}

  .help-box{
    background:var(--paper-raised); border:1px solid var(--line); border-radius:var(--radius);
    padding:16px 18px; margin-bottom:22px; font-size:13px; color:var(--ink-soft);
  }
  .help-box h3{margin:0 0 8px; font-family:var(--font-display); font-size:16px; color:var(--ink);}
  .help-box ol{margin:6px 0 0; padding-left:18px;}
  .help-box li{margin-bottom:4px;}

  .history-entry{padding:16px 18px; margin-bottom:12px;}
  .history-date{font-family:var(--font-mono); font-size:11px; color:var(--slate); margin:0 0 6px;}
  .history-prefs{font-size:12.5px; color:var(--ink-soft); margin:0 0 8px;}
  .history-books{list-style:none; margin:0; padding:0; font-size:13px;}
  .history-books li{padding:4px 0; display:flex; justify-content:space-between; gap:8px; border-bottom:1px dotted var(--line);}
  .history-books li:last-child{border-bottom:none;}
  .tag-added{color:var(--sage); font-family:var(--font-mono); font-size:11px;}
  .tag-rejected{color:var(--slate); font-family:var(--font-mono); font-size:11px;}
  .tag-pending{color:var(--brass-dark); font-family:var(--font-mono); font-size:11px;}
</style>
</head>
<body>
<div class="app-shell">
  <header class="top">
    <p class="eyebrow">Personal Reading Ledger</p>
    <h1 class="title">What Should I Read Next?</h1>
    <p class="subtitle">Track what you've read, log how you felt about it, and get a next-book pick that's actually checked against your shelf — not a bestseller list.</p>
  </header>

  <nav class="tabs" role="tablist" aria-label="Sections">
    <button class="tab-btn active" data-tab="dashboard" role="tab">Dashboard</button>
    <button class="tab-btn" data-tab="shelf" role="tab">My Shelf</button>
    <button class="tab-btn" data-tab="add" role="tab">Add Book</button>
    <button class="tab-btn" data-tab="recommend" role="tab">Recommend</button>
    <button class="tab-btn" data-tab="history" role="tab">History</button>
  </nav>

  <main>
    <section id="panel-dashboard" class="panel active"></section>
    <section id="panel-shelf" class="panel"></section>
    <section id="panel-add" class="panel"></section>
    <section id="panel-recommend" class="panel"></section>
    <section id="panel-history" class="panel"></section>
  </main>
</div>

<div id="toast-region" aria-live="polite"></div>

<script>
/* ============================= STATE ============================= */
const state = {
  books: [],
  history: [],
  activeTab: 'dashboard',
  filters: { status: 'all', genre: 'all', author: '', minRating: 0 },
  editingId: null,
  recResult: null,   // { bestPick, alternatives, preferences, timestamp }
  recStatus: 'idle',  // idle | loading | success | error
  recError: '',
  showHelp: false
};

const STATUSES = ['Want to Read','Currently Reading','Finished','Paused','Abandoned'];

/* ============================= STORAGE ============================= */
async function loadBooks(){
  try{
    const res = await window.storage.get('books', false);
    return res ? JSON.parse(res.value) : [];
  }catch(e){ return []; }
}
async function saveBooks(){
  try{
    await window.storage.set('books', JSON.stringify(state.books), false);
  }catch(e){ toast('Could not save your shelf — try again.', 'error'); }
}
async function loadHistory(){
  try{
    const res = await window.storage.get('recHistory', false);
    return res ? JSON.parse(res.value) : [];
  }catch(e){ return []; }
}
async function saveHistory(){
  try{
    await window.storage.set('recHistory', JSON.stringify(state.history), false);
  }catch(e){ toast('Could not save recommendation history.', 'error'); }
}
async function getOnboarded(){
  try{
    const res = await window.storage.get('onboarded', false);
    return res ? JSON.parse(res.value) : false;
  }catch(e){ return false; }
}
async function setOnboarded(){
  try{ await window.storage.set('onboarded', JSON.stringify(true), false); }catch(e){}
}

/* ============================= UTIL ============================= */
function uid(){ return 'b' + Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
function esc(s){ return (s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function statusClass(status){
  return {
    'Want to Read':'status-want', 'Currently Reading':'status-reading',
    'Finished':'status-finished', 'Paused':'status-paused', 'Abandoned':'status-abandoned'
  }[status] || 'status-want';
}
function shelfMark(book){
  const genreCode = (book.genre||'GEN').replace(/[^A-Za-z]/g,'').slice(0,3).toUpperCase() || 'GEN';
  const lastName = (book.author||'').trim().split(/\s+/).pop() || 'ANN';
  const authorCode = lastName.replace(/[^A-Za-z]/g,'').slice(0,3).toUpperCase() || 'ANN';
  const yearTag = book.id ? book.id.slice(1,3) : '00';
  return `${genreCode}·${authorCode}—${yearTag}`;
}
function starString(rating){
  rating = Number(rating)||0;
  let out = '';
  for(let i=1;i<=5;i++){ out += i<=rating ? '★' : '<span class="empty">★</span>'; }
  return out;
}
function toast(msg, type){
  const region = document.getElementById('toast-region');
  const el = document.createElement('div');
  el.className = 'toast' + (type ? ' '+type : '');
  el.textContent = msg;
  region.appendChild(el);
  setTimeout(()=>{ el.remove(); }, 3600);
}
function fmtDate(d){
  if(!d) return '—';
  try{
    return new Date(d+'T00:00:00').toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
  }catch(e){ return d; }
}

/* ============================= TAB SWITCHING ============================= */
function switchTab(tab){
  state.activeTab = tab;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  document.querySelectorAll('.panel').forEach(p => p.classList.toggle('active', p.id === 'panel-'+tab));
  renderActive();
}
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click', ()=> switchTab(btn.dataset.tab));
});

function renderActive(){
  if(state.activeTab === 'dashboard') renderDashboard();
  else if(state.activeTab === 'shelf') renderShelf();
  else if(state.activeTab === 'add') renderAddForm();
  else if(state.activeTab === 'recommend') renderRecommend();
  else if(state.activeTab === 'history') renderHistory();
}

/* ============================= DASHBOARD ============================= */
function renderDashboard(){
  const el = document.getElementById('panel-dashboard');
  const finished = state.books.filter(b=>b.status==='Finished');
  const reading = state.books.filter(b=>b.status==='Currently Reading');
  const rated = state.books.filter(b=>Number(b.rating)>0);
  const avgRating = rated.length ? (rated.reduce((s,b)=>s+Number(b.rating),0)/rated.length) : 0;

  const genreCounts = {};
  state.books.forEach(b=>{ if(b.genre){ genreCounts[b.genre] = (genreCounts[b.genre]||0)+1; } });
  const topGenres = Object.entries(genreCounts).sort((a,b)=>b[1]-a[1]).slice(0,5);
  const maxCount = topGenres.length ? topGenres[0][1] : 1;
  const topGenreName = topGenres.length ? topGenres[0][0] : '—';

  const recentlyFinished = finished
    .filter(b=>b.dateFinished)
    .sort((a,b)=> new Date(b.dateFinished) - new Date(a.dateFinished))
    .slice(0,5);

  const helpHTML = state.showHelp ? `
    <div class="help-box">
      <h3>Welcome — here's how this works</h3>
      <ol>
        <li>Log books on the <strong>Add Book</strong> tab, including ones you've already finished — ratings and notes power your recommendations.</li>
        <li>Browse and filter everything on <strong>My Shelf</strong>.</li>
        <li>Check <strong>Dashboard</strong> any time for a snapshot of your reading habits.</li>
        <li>When you want a next read, go to <strong>Recommend</strong>, set your mood and constraints, and click the button. Every pick is checked with a live web search, so it may take a few seconds.</li>
        <li><strong>History</strong> keeps a record of past recommendations and what you did with them.</li>
      </ol>
      <button class="btn secondary small" id="dismiss-help" style="margin-top:10px;">Got it</button>
    </div>` : '';

  if(state.books.length === 0){
    el.innerHTML = `
      ${helpHTML}
      <div class="empty-state">
        <div class="glyph">✎</div>
        <h2 class="section-title" style="margin-bottom:6px;">Nothing on the shelf yet</h2>
        <p>Add a book you've read, are reading, or want to read to start building your dashboard.</p>
        <button class="btn" id="dash-add-btn">Add Your First Book</button>
      </div>`;
    document.getElementById('dash-add-btn').addEventListener('click', ()=>switchTab('add'));
    const dismissEmpty = document.getElementById('dismiss-help');
    if(dismissEmpty) dismissEmpty.addEventListener('click', ()=>{ state.showHelp=false; renderDashboard(); });
    return;
  }

  el.innerHTML = `
    ${helpHTML}
    <h2 class="section-title">Dashboard</h2>
    <p class="section-sub">A running snapshot of your reading.</p>

    <div class="grid stats" style="margin-bottom:18px;">
      <div class="card stat-card"><div class="num">${finished.length}</div><div class="label">Finished</div></div>
